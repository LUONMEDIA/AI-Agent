# Example only. NEVER put real credentials into this file or GitHub.
CMS_AGENT_ENABLE_LIVE=NO
CMS_AGENT_APPROVAL_ID=
# Public verification key only. The PRIVATE signing key must NEVER enter Codex/GitHub.
CMS_AGENT_APPROVAL_PUBLIC_KEY_B64=
# Explicit append-only audit destination outside repository, required for --live.
CMS_AGENT_AUDIT_PATH=/secure/outside-repo/cms-audit.jsonl
CMS_AGENT_PROFILE=/secure/outside-repo/profile.json
CMS_AGENT_AUTH_STATE=/secure/outside-repo/auth-state.json
