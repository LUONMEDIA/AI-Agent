{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luonmedia.com/ai-agent/contracts/artifact.schema.json",
  "title": "LUON Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "uri", "sha256", "created_by"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "artifact_type": { "type": "string", "minLength": 1 },
    "uri": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "source_artifact_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "metadata": { "type": "object" },
    "sensitivity": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] }
  }
}
