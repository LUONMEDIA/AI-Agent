{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luonmedia.com/ai-agent/contracts/workflow.schema.json",
  "title": "LUON Workflow Definition",
  "description": "Provider-neutral DAG definition. Task payload semantics remain specialist-owned.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "tasks"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workflow_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "task_type", "required_capability"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "task_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "required_capability": { "type": "string", "minLength": 1, "maxLength": 128 },
          "target_agent": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" },
          "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "idempotency_key": { "type": "string", "minLength": 1 }
        }
      }
    },
  }
}
