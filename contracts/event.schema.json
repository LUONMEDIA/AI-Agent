{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luonmedia.com/ai-agent/contracts/event.schema.json",
  "title": "LUON Task and Workflow Lifecycle Event",
  "description": "Normalized event envelope. Event-chain hashes are stored by the private state store.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "actor", "occurred_at"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": ["string", "null"] },
    "event_type": {
      "type": "string",
      "enum": [
        "workflow.created", "workflow.status_changed",
        "task.created", "task.ready", "task.claimed", "task.started",
        "task.succeeded", "task.blocked", "task.failed",
        "task.needs_reconciliation", "task.cancelled",
        "task.reconciliation_resolved", "task.unblocked",
        "task.accepted", "task.routed", "task.completed",
        "approval.requested", "approval.granted", "approval.revoked",
        "artifact.created", "artifact.verified", "reconciliation.required"
      ]
    },
    "actor": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "reason_code": { "type": "string" },
    "correlation_id": { "type": "string" },
    "details": { "type": "object" },
    "previous_event_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
