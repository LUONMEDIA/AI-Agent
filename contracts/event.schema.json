{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luonmedia.com/ai-agent/contracts/event.schema.json",
  "title": "LUON Task Lifecycle Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "task_id", "event_type", "actor", "occurred_at"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "enum": ["task.accepted", "task.routed", "task.started", "task.blocked", "task.completed", "task.failed", "approval.requested", "approval.granted", "approval.revoked", "artifact.created", "artifact.verified", "reconciliation.required"] },
    "actor": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "reason_code": { "type": "string" },
    "correlation_id": { "type": "string" },
    "details": { "type": "object" },
    "previous_event_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
